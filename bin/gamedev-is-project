#!/usr/bin/env bash
# Detect a Game Studio project in the current working directory, without writes.
# Exit 0 for project-owned markers, otherwise 1; print nothing.
# Session logs and runtime state alone do not identify a game project.
# Run /skill:gamedev-adopt for an existing game missing framework artifacts.

for marker in \
    "docs/technical-preferences.md" \
    "design/registry/entities.yaml" \
    "production/stage.txt" \
    "design/gdd"; do
    [ -e "$marker" ] && exit 0
done

exit 1
